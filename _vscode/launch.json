{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug backend (API)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "program": "${workspaceFolder}/backend/src/server.js",
      "runtimeArgs": ["--disable-warning=ExperimentalWarning"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug tests del backend",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "runtimeArgs": ["--disable-warning=ExperimentalWarning", "--test", "tests/burnRate.test.js", "tests/api.test.js"],
      "console": "integratedTerminal"
    }
  ]
}
