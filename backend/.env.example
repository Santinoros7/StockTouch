# Copiá este archivo como ".env" y completá lo que necesites.

# Puerto de la API
PORT=3001

# Ruta del archivo de base de datos SQLite
DB_PATH=./data/stocktouch.sqlite

# --- WhatsApp vía Twilio (OPCIONAL) ---
# Si dejás esto vacío, los mensajes se SIMULAN (se guardan y se ven en la app).
# Para enviarlos de verdad usá el Sandbox de WhatsApp de Twilio:
# https://www.twilio.com/docs/whatsapp/sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número de WhatsApp de Twilio, ej: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
